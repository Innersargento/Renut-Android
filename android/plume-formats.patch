+        VKAPI_ATTR void VKAPI_CALL memTraceAllocate(VmaAllocator, uint32_t type, VkDeviceMemory memory, VkDeviceSize size, void *user) {
+            // The device address of the block's first byte: a small buffer bound at offset 0
+            // is asked for it and dropped, so even a block that holds only images has a known VA.
+            uint64_t address = 0;
+            if (g_plumeMemTrace.load(std::memory_order_relaxed) && user != nullptr) {
+                VkDevice device = static_cast<VulkanDevice *>(user)->vk;
+                VkBufferCreateInfo info = {};
