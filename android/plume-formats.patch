+                info.size = std::min<VkDeviceSize>(size, 4096);
+                info.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
+                info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+                VkBuffer probe = VK_NULL_HANDLE;
+                if (vkCreateBuffer(device, &info, nullptr, &probe) == VK_SUCCESS) {
+                    if (vkBindBufferMemory(device, probe, memory, 0) == VK_SUCCESS) {
+                        VkBufferDeviceAddressInfo addressInfo = {};
+                        addressInfo.sType = VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO;
+                        addressInfo.buffer = probe;
+                        address = vkGetBufferDeviceAddress(device, &addressInfo);
+                    }
+                    vkDestroyBuffer(device, probe, nullptr);
+                }
+            }
+            memEvent('M', uint64_t(memory), size, type, address);
+        }
+
+        VKAPI_ATTR void VKAPI_CALL memTraceFree(VmaAllocator, uint32_t type, VkDeviceMemory memory, VkDeviceSize size, void *) {
+            memEvent('m', uint64_t(memory), size, type);
