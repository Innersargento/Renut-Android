+  }
+  std::lock_guard<std::mutex> lock(mutex);
+  for (size_t i = 0; i < seen_count; ++i) {
+    if (seen[i] == key) {
+      if (++repeats % 20000 == 0) {
+        REXGPU_WARN("Suppressed {} repeated invalid fetch constant warnings.", repeats);
+      }
+      return false;
+    }
+  }
+  if (seen_count < seen.size()) {
+    seen[seen_count++] = key;
+    return true;
+  }
+  // More distinct descriptors than the table holds: keep counting instead of
+  // reporting, so an unbounded pattern cannot flood the log either.
+  ++repeats;
+  return false;
+}
