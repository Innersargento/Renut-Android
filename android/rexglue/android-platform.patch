+void KernelState::DumpGuestThreadsForDiagnostics(uint64_t host_now_ms) {
+  static const char* kTypeNames[] = {"undef",  "enum",   "event",  "file",   "iocomp",
+                                     "module", "mutant", "notify", "sema",   "session",
+                                     "socket", "symlink", "thread", "timer"};
+  auto load_u32 = [this](uint32_t address) {
+    return memory::load_and_swap<uint32_t>(memory()->TranslateVirtual(address));
+  };
+  REXSYS_INFO("Renut: thread dump ({} threads)", threads_by_id_.size());
+  for (auto& [id, thread] : threads_by_id_) {
+    if (!thread) {
+      continue;
+    }
+    auto& diag = thread->wait_diag();
+    std::string line = fmt::format("  [{:08X}] '{}' obj={:08X}{}", id,
+                                   thread->thread() ? thread->thread()->name() : std::string(),
+                                   thread->guest_object(), thread->is_running() ? "" : " EXITED");
+    uint64_t start_ms = diag.start_ms.load();
+    if (start_ms) {
+      line += fmt::format(" WAIT {}ms lr={:08X} timeout={} alertable={} objs=",
+                          host_now_ms - std::min(host_now_ms, start_ms), diag.guest_lr.load(),
+                          int64_t(diag.timeout_ms.load() == UINT32_MAX ? -1
+                                                                       : diag.timeout_ms.load()),
+                          diag.alertable.load());
+      uint32_t count = std::min(diag.count.load(), XThread::WaitDiag::kMaxObjects);
+      for (uint32_t i = 0; i < count; ++i) {
+        uint32_t type = diag.types[i].load();
+        line += fmt::format("{}{}:{:08X}", i ? "," : "",
+                            type < std::size(kTypeNames) ? kTypeNames[type] : "?",
+                            diag.objects[i].load());
+      }
+      if (diag.count.load() > count) {
+        line += fmt::format(" (+{})", diag.count.load() - count);
+      }
+    } else {
+      line += " run/delay";
+    }
+    // Guest back chain: frame[0] is the caller's SP, and a non-leaf callee saves
+    // its LR at -8 from that caller SP.
+    // Exited threads have freed their stacks (XThread::Exit -> FreeStack).
+    auto* state = thread->thread_state();
+    if (thread->is_running() && state && state->context()) {
+      auto* ctx = state->context();
+      line += fmt::format(" | lr={:08X} sp={:08X} stack:", uint32_t(ctx->lr), ctx->r1.u32);
+      // Only walk inside this thread's committed stack: r1 is read racily and a
+      // stray value would fault on the guard or an unmapped page.
+      uint32_t stack_low = 0, stack_high = 0;
+      if (thread->guest_object()) {
+        auto* kthread = thread->guest_object<X_KTHREAD>();
+        stack_low = kthread->stack_limit;
+        stack_high = kthread->stack_base;
+      }
+      uint32_t sp = ctx->r1.u32;
+      for (int depth = 0; depth < 14; ++depth) {
+        if (sp < stack_low || sp + 4 > stack_high || (sp & 3)) {
+          break;
+        }
+        uint32_t back = load_u32(sp);
+        if (back <= sp || back + 4 > stack_high || back - 8 < stack_low) {
+          break;
+        }
+        line += fmt::format(" {:08X}", load_u32(back - 8));
+        sp = back;
+      }
+    }
+    REXSYS_INFO("{}", line);
+  }
+}
