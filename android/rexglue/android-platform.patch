+// Invalid fetch constants repeat on every draw that samples an unbound slot.
+// Logging each one buries the rest of the session: a stuck frame produced
+// ~2400 identical lines in eleven seconds and rotated everything else away.
+// Report every distinct descriptor once, then count the repeats and emit a
+// single periodic summary so the flood stays visible without hiding it.
+bool ShouldReportInvalidFetch(const uint32_t* dwords, size_t dword_count) {
+  static std::mutex mutex;
+  static std::array<uint64_t, 64> seen{};
+  static size_t seen_count = 0;
+  static uint64_t repeats = 0;
+  uint64_t key = 0xcbf29ce484222325ull;
